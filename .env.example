# ---------------------------------------------------------------
# GTA6-Kompass – Umgebungsvariablen
# Kopiere diese Datei nach .env.local und trage deine Werte ein.
# Niemals echte Schlüssel in Git einchecken!
# ---------------------------------------------------------------

# Öffentliche Basis-URL der Website (für Sitemap, Canonical-URLs, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kontakt-E-Mail für Kontaktseite und Impressum (optional, sonst Platzhalter)
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Supabase (Datenbank, Auth, Speicher) ----------------------
# Zu finden im Supabase-Dashboard unter Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- KI-Assistent ----------------------------------------------
# Anbieter: "anthropic" oder "none" (ohne Anbieter zeigt der Chat eine Konfigurationsmeldung)
AI_PROVIDER=none
# Nur serverseitig verwendet – niemals mit NEXT_PUBLIC_ versehen!
ANTHROPIC_API_KEY=
# Optional: anderes Modell wählen (Standard: claude-opus-5-5)
AI_MODEL=
# Maximale Anfragen pro IP und Minute an den KI-Assistenten
AI_RATE_LIMIT_PER_MINUTE=8
